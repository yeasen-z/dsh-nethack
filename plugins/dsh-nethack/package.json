{
  "name": "@yeaszn/dsh-neth4ck",
  "version": "0.2.2",
  "type": "module",
  "description": "Play NetHack inside DeepSeek Harness: a Host plugin runs the NetHack WASM engine on a worker thread and exposes observe/act/respond tools to the model, with the live game as a central panel opened from a top-left \"@\" entry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeasen-z/dsh-nethack.git",
    "directory": "plugins/dsh-nethack"
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "nethack",
    "game",
    "agent"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dependencies": {
    "@neth4ck/wasm-367": "2.1.2"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.webp",
    "market/*.json",
    "scripts/market-index.mjs",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "market-index": "node scripts/market-index.mjs",
    "test": "node --test tests/*.mjs"
  }
}
